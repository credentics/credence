# ── Credence Build-Time Environment Variables ──
#
# Copy this file to .env and fill in your values.
# These are passed to Flutter via --dart-define flags at build time.
#
# Example usage:
#   flutter run \
#     --dart-define=DROPBOX_APP_KEY=$DROPBOX_APP_KEY \
#     --dart-define=GOOGLE_DRIVE_CLIENT_ID=$GOOGLE_DRIVE_CLIENT_ID \
#     --dart-define=BRANDFETCH_CLIENT_ID=$BRANDFETCH_CLIENT_ID
#
# Or source the file and use a helper script (see scripts/run.sh).

# Dropbox OAuth app key (from https://www.dropbox.com/developers/apps)
DROPBOX_APP_KEY=

# Google Drive OAuth 2.0 client ID (from Google Cloud Console)
GOOGLE_DRIVE_CLIENT_ID=

# Brandfetch API client ID (from https://brandfetch.com)
BRANDFETCH_CLIENT_ID=
